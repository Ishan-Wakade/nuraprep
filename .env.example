# Foundation
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Milestone 1: local PostgreSQL. Never use production credentials locally.
DATABASE_URL=postgresql://nuraprep:nuraprep@localhost:5432/nuraprep
DIRECT_URL=postgresql://nuraprep:nuraprep@localhost:5432/nuraprep
# Optional override. The default derives a sibling database named nuraprep_e2e.
# Safety checks refuse to reset a database whose name does not end in _e2e.
E2E_DATABASE_URL=postgresql://nuraprep:nuraprep@localhost:5432/nuraprep_e2e

# Optional local reviewer bypass. This switch is rejected when APP_ENV=production.
DEV_REVIEWER_ENABLED=true

# Optional local learner bypass. This switch is rejected when APP_ENV=production.
DEV_LEARNER_ENABLED=true

# Milestone 6: server-side generation and tutoring.
# OPENAI_API_KEY=

# Milestone 7: authentication. Generate a unique 32+ character secret per environment.
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Milestone 8: Stripe test mode only during development.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Milestone 9: AWS. Prefer workload identity; do not commit long-lived access keys.
# AWS_REGION=us-east-1
# SOURCE_ARTIFACTS_BUCKET=
